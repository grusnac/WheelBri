<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the bridge's portable parts (wire formats, PID decoding) on any OS: dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wheelemu.Bridge.SelfTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Wire.cs" />
    <Compile Include="..\PidForwarder.cs" />
    <Compile Include="..\HidHide.cs" />
  </ItemGroup>
</Project>
