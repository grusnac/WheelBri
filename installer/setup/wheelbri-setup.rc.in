// wheelbri-setup.exe's resources (also Uninstaller.exe in the install folder): WheelBri's icon, the same as the app's,
// and version information. CMake makes wheelbri-setup.rc from this file in the build folder, with the version.
#include <winver.h>

1 ICON "@WE_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WheelBri setup and uninstaller"
            VALUE "ProductName", "WheelBri"
            VALUE "LegalCopyright", "Copyright (C) 2026 Grigore Rusnac. GPL-3.0-or-later, no warranty."
            VALUE "LegalTrademarks", "Logitech and its wheel names are trademarks of Logitech. WheelBri is not affiliated with Logitech."
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "wheelbri-setup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
