// wheelbri.exe's resources: the manifest (Administrator, DPI awareness) and version information.
#include <winver.h>

1 24 "wheelbri.exe.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,5,0,0
PRODUCTVERSION 0,5,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WheelBri: your rig as a Logitech G920"
            VALUE "ProductName", "WheelBri"
            VALUE "FileVersion", "0.5.0"
            VALUE "ProductVersion", "0.5.0 beta 1 (very early beta)"
            VALUE "OriginalFilename", "wheelbri.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
