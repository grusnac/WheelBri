// wheelbri-service.exe's resources: the icon and version information (no manifest: it runs as whoever starts it).
// CMake makes wheelbri-service.rc from this file in the build folder (configure_file), with the project's version.
#include <winver.h>

1 ICON "@WE_APP_DIR@/wheelbri.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WheelBri service (command line)"
            VALUE "ProductName", "WheelBri"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductVersion", "@PROJECT_VERSION@ (early beta)"
            VALUE "OriginalFilename", "wheelbri-service.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
