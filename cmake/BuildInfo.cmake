# Writes OUT (a header) with the git commit the build comes from, for the version in the app's top-right corner:
#   #define WHEELBRI_BUILD "ee5b047"    (with a + when the checkout had uncommitted changes; "" without git)
# Run on every build (cmake -P, from service/CMakeLists.txt); the file is rewritten only when its text changes, so
# nothing is recompiled for nothing.
#   cmake -DSRC=<repository> -DOUT=<header> -P BuildInfo.cmake

set(build "")
find_program(GIT_EXECUTABLE git)
if(GIT_EXECUTABLE)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" rev-parse --short=7 HEAD
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
    if(NOT failed AND commit)
        set(build "${commit}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" status --porcelain --untracked-files=no
                        OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(changes)
            string(APPEND build "+")
        endif()
    endif()
endif()

set(text "#pragma once\n// Generated by cmake/BuildInfo.cmake on every build: the git commit, + = uncommitted changes.\n#define WHEELBRI_BUILD \"${build}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT "${old}" STREQUAL "${text}")
    file(WRITE "${OUT}" "${text}")
endif()
