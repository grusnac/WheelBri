;
; wheelemu-hide.inf: hides the real wheel (Moza R3) from games while wheelemu-service runs (see Driver.cpp).
;
; Installs on the R3's game-controller interface only (HID\VID_346E&PID_0005&MI_02): the same setup Windows
; gives it (input.inf, "HID-compliant game controller"), plus our UMDF 2 filter above it. While the service is
; not running the filter lets everything through. Install: driver\hide\install-hide.ps1 (Administrator);
; remove: driver\hide\uninstall-hide.ps1. Needs Windows 11.
;
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
DriverVer=
CatalogFile=wheelemu-hide.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
wheelemu-hide.dll=1

[Manufacturer]
%Provider%=Wheelemu,NT$ARCH$.10.0...22000

[Wheelemu.NT$ARCH$.10.0...22000]
%DeviceDesc%=WheelemuHide, HID\VID_346E&PID_0005&MI_02

; --- Windows' own game-controller setup (input.inf), with the filter added ---------------------------------

[WheelemuHide.NT]
Include=input.inf
Needs=HID_Raw_Inst.NT
CopyFiles=UMDriverCopy

[WheelemuHide.NT.HW]
AddReg=WheelemuHide_AddReg

[WheelemuHide_AddReg]
; The UMDF reflector as the upper filter of this device; it hosts wheelemu-hide.dll.
HKR,,"UpperFilters",0x00010008,"WUDFRd"

[WheelemuHide.NT.Services]
; No function driver (as Windows does for game controllers). The reflector service WUDFRd named in UpperFilters is
; part of Windows (every UMDF driver uses it), so it is not installed here.
Include=input.inf
Needs=HID_Raw_Inst.NT.Services

[WheelemuHide.NT.Wdf]
UmdfService=wheelemu_hide, WheelemuHide_Install
UmdfServiceOrder=wheelemu_hide
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
; The HID class driver below keeps its own data in FsContext: the reflector uses FsContext2.
UmdfFsContextUsePolicy=CanUseFsContext2

[WheelemuHide_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary="%13%\wheelemu-hide.dll"

[UMDriverCopy]
wheelemu-hide.dll

[Strings]
Provider="wheel-emulator"
DiskName="wheel-emulator wheel hiding filter"
DeviceDesc="HID-compliant game controller (wheelemu: hidden from games while wheelemu-service runs)"
