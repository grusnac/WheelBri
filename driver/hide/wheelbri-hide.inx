;
; wheelbri-hide.inf: hides the rig (every device the Wheel setup tab defined) from games while wheelbri-service runs
; (see Driver.cpp).
;
; Its only hardware id, WHEELBRI_HIDE_FILTER, belongs to no device: Windows never puts it on anything by itself (when
; it matched game controllers' compatible ids, Windows put it on the virtual G920). driver\hide\install-hide.ps1
; -Devices puts it on exactly the interfaces it is given, taking it from this INF's models for the HIDClass class (as
; Device Manager's "Have disk" does without "Show compatible hardware"); the app runs that at Start with the game
; controllers of the active rig, so it fits any wheel, pedals or shifter without a list of ids here. DriverVer is
; also stamped 01/01/2001 (see the .vcxproj) so it never outranks Windows' own driver. It gives each one
; the same setup Windows gives it (input.inf, "HID-compliant game controller"), plus our UMDF 2 filter above it.
; While the service is not running the filter lets everything through. Remove: driver\hide\uninstall-hide.ps1.
; Needs Windows 11.
;
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
DriverVer=
CatalogFile=wheelbri-hide.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
wheelbri-hide.dll=1

[Manufacturer]
%Provider%=Wheelbri,NT$ARCH$.10.0...22000

[Wheelbri.NT$ARCH$.10.0...22000]
%DeviceDesc%=WheelbriHide, WHEELBRI_HIDE_FILTER

; --- Windows' own game-controller setup (input.inf), with the filter added ---------------------------------

[WheelbriHide.NT]
Include=input.inf
Needs=HID_Raw_Inst.NT
CopyFiles=UMDriverCopy

[WheelbriHide.NT.HW]
AddReg=WheelbriHide_AddReg

[WheelbriHide_AddReg]
; The UMDF reflector as the upper filter of this device; it hosts wheelbri-hide.dll.
HKR,,"UpperFilters",0x00010008,"WUDFRd"

[WheelbriHide.NT.Services]
; No function driver (as Windows does for game controllers). The reflector service WUDFRd named in UpperFilters is
; part of Windows (every UMDF driver uses it), so it is not installed here.
Include=input.inf
Needs=HID_Raw_Inst.NT.Services

[WheelbriHide.NT.Wdf]
UmdfService=wheelbri_hide, WheelbriHide_Install
UmdfServiceOrder=wheelbri_hide
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
; The HID class driver below keeps its own data in FsContext: the reflector uses FsContext2.
UmdfFsContextUsePolicy=CanUseFsContext2

[WheelbriHide_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary="%13%\wheelbri-hide.dll"

[UMDriverCopy]
wheelbri-hide.dll

[Strings]
Provider="WheelBri"
DiskName="WheelBri wheel hiding filter"
DeviceDesc="HID-compliant game controller (wheelbri: hidden from games while wheelbri-service runs)"
