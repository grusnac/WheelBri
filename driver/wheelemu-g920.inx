;
; wheelemu-g920.inf: the virtual Logitech G920 of wheel-emulator (UMDF 2 HID minidriver).
;
; The device is a software device that wheelemu-service creates while it runs (--virtual-g920), with hardware
; ID wheelemu\G920. The same driver serves the HID side of the virtual Xbox 360 controller (wheelemu\XBOXHID),
; which joy.cpl lists as "Controller (XBOX 360 For Windows)". Install: driver\install-driver.ps1 (Administrator).
; Needs Windows 11 (MsHidUmdf.inf, 22000+).
;
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
DriverVer=
CatalogFile=wheelemu-g920.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
wheelemu-g920.dll=1

[Manufacturer]
%Provider%=Wheelemu,NT$ARCH$.10.0...22000

[Wheelemu.NT$ARCH$.10.0...22000]
%DeviceDesc%=WheelemuG920, wheelemu\G920
%XboxDesc%=WheelemuG920, wheelemu\XBOXHID

[WheelemuG920.NT]
CopyFiles=UMDriverCopy
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT

[WheelemuG920.NT.hw]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.hw
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.hw

[WheelemuG920.NT.Services]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.Services
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Services

[WheelemuG920.NT.Filters]
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Filters

[WheelemuG920.NT.Wdf]
UmdfService="wheelemu_g920", WheelemuG920_Install
UmdfServiceOrder=wheelemu_g920
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

[WheelemuG920_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary="%13%\wheelemu-g920.dll"

[UMDriverCopy]
wheelemu-g920.dll

[Strings]
Provider="wheel-emulator"
DiskName="wheel-emulator G920 driver"
DeviceDesc="Logitech G920 Driving Force Racing Wheel USB (wheelemu)"
XboxDesc="Controller (XBOX 360 For Windows) (wheelemu)"
