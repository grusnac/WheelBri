;
; wheelbri-wheel.inf: WheelBri's virtual wheel, a Logitech G25, G27, G920 or G923 (UMDF 2 HID minidriver).
;
; The device is a software device that wheelbri-service creates while it runs (--virtual-wheel), with hardware
; ID wheelbri\G25, wheelbri\G27, wheelbri\G920 or wheelbri\G923: one driver for all of them, the id decides which
; wheel it is. Called wheelbri-g920 until 2026-10-19; install-driver.ps1 removes that package.
; wheelbri\G923_TF is the G923's TrueForce interface, a second device the service makes with it on request.
; Install: driver\install-driver.ps1 (Administrator).
; Needs Windows 11 (MsHidUmdf.inf, 22000+).
;
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
DriverVer=
CatalogFile=wheelbri-wheel.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
wheelbri-wheel.dll=1

[Manufacturer]
%Provider%=Wheelbri,NT$ARCH$.10.0...22000

[Wheelbri.NT$ARCH$.10.0...22000]
%DeviceDesc%=WheelbriWheel, wheelbri\G920
%DeviceDescG25%=WheelbriWheel, wheelbri\G25
%DeviceDescG27%=WheelbriWheel, wheelbri\G27
%DeviceDescG923%=WheelbriWheel, wheelbri\G923
%DeviceDescG923TF%=WheelbriWheel, wheelbri\G923_TF

[WheelbriWheel.NT]
CopyFiles=UMDriverCopy
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT

[WheelbriWheel.NT.hw]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.hw
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.hw

[WheelbriWheel.NT.Services]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.Services
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Services

[WheelbriWheel.NT.Filters]
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Filters

[WheelbriWheel.NT.Wdf]
UmdfService="wheelbri_wheel", WheelbriWheel_Install
UmdfServiceOrder=wheelbri_wheel
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

[WheelbriWheel_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary="%13%\wheelbri-wheel.dll"

[UMDriverCopy]
wheelbri-wheel.dll

[Strings]
Provider="WheelBri"
DiskName="WheelBri wheel driver"
DeviceDesc="Logitech G920 Driving Force Racing Wheel USB (wheelbri)"
DeviceDescG25="Logitech G25 Racing Wheel USB (wheelbri)"
DeviceDescG27="Logitech G27 Racing Wheel USB (wheelbri)"
DeviceDescG923="Logitech G923 Racing Wheel for Xbox One and PC (wheelbri)"
DeviceDescG923TF="Logitech G923 Racing Wheel for Xbox One and PC TrueForce (wheelbri)"
